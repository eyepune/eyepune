# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── LLM API (server-side only — never exposed to client) ─────────────
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_API_KEY=your-nvidia-api-key-here
LLM_MODEL=moonshotai/kimi-k2.6

# ── Zoho Mail (for transactional emails via Zoho Mail API) ────────────
# Step 1: Go to https://api-console.zoho.in/ → Register as Developer
# Step 2: Create a Server-Side Application client
# Step 3: Add scope: ZohoMail.messages.CREATE
# Step 4: Generate refresh token (see guide)
ZOHO_CLIENT_ID=your-zoho-client-id-here
ZOHO_CLIENT_SECRET=your-zoho-client-secret-here
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token-here
ZOHO_MAIL_ACCOUNT_ID=your-zoho-mail-account-id-here
ZOHO_MAIL_USERNAME=connect@eyepune.com

# ── Resend (alternative email provider — optional) ────────────────────
RESEND_API_KEY=your-resend-api-key-here

# ── Razorpay (for payments) ──────────────────────────────────────────
# Step 1: Go to https://dashboard.razorpay.com/ → Settings → API Keys
# Step 2: Generate Key ID and Key Secret
# Step 3: Set up webhook endpoint for payment confirmations
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id-here
# Get from: Razorpay Dashboard → Settings → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# ── Analytics & Marketing ──────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# ── Cloudflare Turnstile (optional, for form protection) ────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Security ──────────────────────────────────────────────────────────
# Used by GitHub Actions cron jobs to authenticate API calls to the live site
# Generate with: openssl rand -hex 32 (or any strong random 32+ char string)
# Must EXACTLY match: GitHub repo → Settings → Secrets → Actions → CRON_SECRET
# AND: Vercel Dashboard → project → Settings → Environment Variables → CRON_SECRET
CRON_SECRET=your-strong-random-secret-here

# ── Auto Blog Syndication ──────────────────────────────────────────────
# Dev.to: https://dev.to/settings/extensions (API Keys section)
DEVTO_API_KEY=your-devto-api-key
# Hashnode: https://hashnode.com/settings/developer
HASHNODE_API_KEY=your-hashnode-api-key
# Medium: https://medium.com/me/settings (Integration tokens section)
MEDIUM_INTEGRATION_TOKEN=your-medium-token

# ── X (Twitter) Automation ─────────────────────────────────────────────
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# ── LinkedIn ──────────────────────────────────────────────────────────
# Get from: LinkedIn Developer Console → Your App → OAuth 2.0 tools
# OR save token in Supabase system_settings (key: linkedin_config, value: {"token":"...", "urn":"..."})
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
# Optional: to post as a Company Page instead of personal profile
LINKEDIN_ORGANIZATION_ID=your-linkedin-org-id

# ── WhatsApp Business API (Meta Cloud API) ────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-number-id
ADMIN_WHATSAPP_NUMBER=919XXXXXXXXX
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ── Google Business Profile (GMB) ──────────────────────────────────────
GMB_ACCOUNT_ID=your-gmb-account-id
GMB_LOCATION_ID=your-gmb-location-id
GMB_ACCESS_TOKEN=your-gmb-access-token
